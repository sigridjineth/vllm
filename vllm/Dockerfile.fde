
# Use NVIDIA CUDA base image for build capability
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

# Set working directory
WORKDIR /workspace

# Install system dependencies
# git, curl for uv, etc.
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install uv using multi-stage copy (more robust)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install Python and create venv using uv
# vLLM typically supports 3.9-3.12. Using 3.10 as a safe default for compatibility.
RUN uv python install 3.10
RUN uv venv /workspace/.venv

# Activate venv
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="/workspace/.venv/bin:$PATH"

# Copy the local vLLM source code into the container
COPY . /workspace/vllm

# Install build dependencies and vLLM
# This might take a while as it compiles vLLM extensions
WORKDIR /workspace/vllm
RUN uv pip install --upgrade pip
# Install PyTorch with CUDA 11.8 support explicitly
RUN uv pip install torch==2.4.0 torchvision==0.19.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu118
RUN uv pip install -e . --no-build-isolation

# Copy the conversion script to workspace root
WORKDIR /workspace
COPY vllm/convert_to_fde_config.py /workspace/

# Build arguments for FDE model conversion
ARG MODEL_ID=BAAI/bge-m3
ARG KSIM=6
ARG D_PROJ=32
ARG R_REPS=10
ARG FILL_EMPTY=true

# Run the conversion script
# We need to ensure torch is available (installed via vllm dependency)
RUN python3 convert_to_fde_config.py \
    --model ${MODEL_ID} \
    --output /workspace/bge-m3-fde \
    --ksim ${KSIM} \
    --d_proj ${D_PROJ} \
    --R_reps ${R_REPS} \
    $( [ "${FILL_EMPTY}" = "true" ] && echo "--fill_empty_clusters" )

# Set environment variables
ENV VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# Expose the port
EXPOSE 8000

# Set the default command
CMD ["vllm", "serve", "/workspace/bge-m3-fde", "--trust-remote-code", "--dtype", "float16", "--enforce-eager"]
